{
    "name": "treeline",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "yarn workspaces foreach -A --exclude treeline --exclude @treeline/core run build",
        "typecheck": "tsc -b",
        "lint": "oxlint",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
